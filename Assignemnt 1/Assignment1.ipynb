   "source": [
    "\n",
    "\n",
    "\n",
    "training_data_aug_reg = Augmented(clock_train_reg, aug_clock)\n",
    "\n",
    "model_TellTheTime_reg = CNN(image_size=75, in_channel=1, x=0.3, y=0.3, num_classes=1,\n",
    "                            conv_layers=nn.Sequential(\n",
    "    nn.Conv2d(1,  75, kernel_size=3, padding=1),    nn.BatchNorm2d(75),  nn.ReLU(),\n",
    "    nn.Conv2d(75, 75, kernel_size=3, padding=1),    nn.BatchNorm2d(75),  nn.ReLU(),\n",
    "    nn.MaxPool2d(2),\n",
    "    nn.Dropout2d(0.1),\n",
    "    nn.Conv2d(75, 128, kernel_size=3, padding=1),   nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.Conv2d(128, 128, kernel_size=3, padding=1),  nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.MaxPool2d(2),\n",
    "    nn.Dropout2d(0.2),\n",
    "    nn.Conv2d(128, 184, kernel_size=3, padding=1),  nn.BatchNorm2d(184), nn.ReLU(),\n",
    "    nn.Conv2d(184, 184, kernel_size=3, padding=1),  nn.BatchNorm2d(184), nn.ReLU(),\n",
    "    nn.AdaptiveAvgPool2d(1),\n",
    "))\n",
    "\n",
    "history_reg_mse, best_reg_mse = train_model(model=model_TellTheTime_reg, train_dataset=training_data_aug_reg,\n",
    "                                            regression=True, loss_fn=nn.MSELoss(),\n",
    "                                            save_path=\"best_model_CNN_TellTheTime_reg_mse.pt\",\n",
    "                                            epoches=150, lr=1e-3, optimizer_cls=torch.optim.AdamW,\n",
    "                                            optimizer_kwargs={\"weight_decay\": 0.05}, val_ratio=0.1111)\n",
    "plot_history(history_reg_mse, title=\"Tell the time, regression (MSE)\")"
   ]
  },
