    "def to_clock(minutes):\n",
    "    \"\"\"Minutes since 0:00 -> clock text, e.g. 630 -> '10:30'. Wraps around 12 hours.\"\"\"\n",
    "    minutes = int(round(minutes)) % 720\n",
    "    hours, mins = divmod(minutes, 60)\n",
    "    return f\"{hours}:{mins:02d}\"\n",
    "\n",
    "\n",
    "def show_predictions(model, dataset, n=8, regression=False, bin_minutes=30, load_path=None, seed=0):\n",
    "    \"\"\"Pick n random images from a dataset, run the model on them and show\n",
    "    the true time, what the model outputs and the predicted time on the clock.\n",
    "    regression=False: output is a class -> shown as its time range (bin_minutes wide)\n",
    "    regression=True : output is hours, e.g. 10.5 -> 10.5 * 60 = 630 minutes -> 10:30\"\"\"\n",
    "    if load_path is not None:\n",
    "        model.load_state_dict(torch.load(load_path, map_location=device))\n",
    "    model.to(device).eval()\n",
    "\n",
    "    idx = torch.randperm(len(dataset), generator=torch.Generator().manual_seed(seed))[:n]\n",
    "    cols = 4\n",
    "    rows = (n + cols - 1) // cols\n",
    "    fig, axes = plt.subplots(rows, cols, figsize=(3.2 * cols, 3.6 * rows), squeeze=False)\n",
    "\n",
    "    for ax in axes.flat:\n",
    "        ax.axis(\"off\")\n",
    "    for ax, i in zip(axes.flat, idx.tolist()):\n",
    "        x, y = dataset[i]\n",
    "        with torch.no_grad():\n",
    "            out = model(x.unsqueeze(0).to(device))[0].cpu()     # add a batch dimension of 1\n",
    "\n",
    "        if regression:\n",
    "            pred_hours = out.item()\n",
    "            pred_min   = pred_hours * 60                         # hours -> minutes\n",
    "            true_min   = y.item() * 60\n",
    "            true_text  = to_clock(true_min)\n",
    "            pred_text  = f\"output {pred_hours:.2f} -> {to_clock(pred_min)}\"\n",
    "        else:\n",
    "            cls      = out.argmax().item()\n",
    "            prob     = torch.softmax(out, dim=0)[cls].item()    # how sure the model is\n",
    "            true_cls = y.item()\n",
    "            pred_min = cls * bin_minutes + bin_minutes / 2       # middle of the bin\n",
    "            true_min = true_cls * bin_minutes + bin_minutes / 2\n",
    "            true_text = (f\"class {true_cls} ({to_clock(true_cls * bin_minutes)}\"\n",
    "                         f\"-{to_clock(true_cls * bin_minutes + bin_minutes - 1)})\")\n",
    "            pred_text = (f\"class {cls} ({to_clock(cls * bin_minutes)}\"\n",
    "                         f\"-{to_clock(cls * bin_minutes + bin_minutes - 1)}), {prob:.0%}\")\n",
    "\n",
    "        off = common_sense_error_min(torch.tensor(pred_min / 60), torch.tensor(true_min / 60)).item()\n",
    "        print(f\"image {i:>5} | true {true_text:<22} | predicted {pred_text:<32} | off {off:.0f} min\")\n",
    "        ax.imshow(x.squeeze(0), cmap=\"gray\")\n",
    "        ax.set_title(f\"true: {true_text}\\npred: {pred_text}\\noff {off:.0f} min\", fontsize=8)\n",
    "\n",
    "    fig.tight_layout()\n",
    "    plt.show()"
