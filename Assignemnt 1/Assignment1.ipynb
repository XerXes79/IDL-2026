    "\n",
    "# start from the best weights of the first run\n",
    "model_TellTheTime_Classification_5min.load_state_dict(\n",
    "    torch.load(f\"weights_saved/{first_name}.pt\", map_location=device))\n",
    "\n",
    "history_TellTheTime_5min_cont, best_TellTheTime_5min_cont = train_model(model=model_TellTheTime_Classification_5min,\n",
    "                                                              train_dataset=training_data_aug_TellTheTime_5min,\n",
    "                                                              num_classes=n_classes,\n",
    "                                                              save_path=f\"{cont_name}.pt\",\n",
    "                                                              epoches=30, lr=3e-4,\n",
    "                                                              optimizer_cls=torch.optim.AdamW,\n",
    "                                                              optimizer_kwargs={\"weight_decay\": 0.05},\n",
    "                                                              val_ratio=0.1111)\n",
    "test_TellTheTime_5min_cont = evaluate_model(model=model_TellTheTime_Classification_5min, test_dataset=clock_test_5min,\n",
    "                                            num_classes=n_classes,\n",
    "                                            load_path=f\"weights_saved/{cont_name}.pt\")\n",
    "\n",
    "# glue: first run + continued run\n",
    "history_first, _ = load_run(first_name)\n",
    "history_cont, _  = load_run(cont_name)\n",
    "history_TellTheTime_5min_full = {k: history_first[k] + history_cont[k] for k in history_first}\n",
    "\n",
    "# save the complete run, readable later with load_run(full_name)\n",
    "with open(f\"history_saved/{full_name}.csv\", \"w\", newline=\"\") as f:\n",
    "    writer = csv.writer(f)\n",
    "    writer.writerow([\"epoch\"] + list(history_TellTheTime_5min_full))\n",
    "    for e in range(len(history_TellTheTime_5min_full[\"train_loss\"])):\n",
    "        writer.writerow([e] + [history_TellTheTime_5min_full[k][e] for k in history_TellTheTime_5min_full])\n",
    "with open(f\"history_saved/{full_name}_test.csv\", \"w\", newline=\"\") as f:\n",
    "    writer = csv.writer(f)\n",
    "    writer.writerow(test_TellTheTime_5min_cont.keys())\n",
    "    writer.writerow(test_TellTheTime_5min_cont.values())\n",
    "\n",
    "plot_history(history_TellTheTime_5min_full, test_TellTheTime_5min_cont,\n",
