    "def evaluate_model(**kwargs):\n",
    "    \"\"\"Function to evaluate the model with test set.\n",
    "    default         : classification (accuracy / precision / F1).\n",
    "    regression=True : one continuous output (time in hours).\n",
    "    multihead=True  : hour head + minute head, L = L_hour + alpha * L_minute.\n",
    "    Regression and multi-head report the common-sense error in minutes (12-hour wrap-around).\"\"\"\n",
    "    test_model     = kwargs.get(\"model\", NeuralNetwork())\n",
    "    test_dataset   = kwargs.get(\"test_dataset\", test_data)\n",
    "    load_path      = kwargs.get(\"load_path\", \"best_model.pt\")\n",
    "    batch_size     = kwargs.get(\"batch_size\", 64)\n",
    "    regression     = kwargs.get(\"regression\", False)\n",
    "    multihead      = kwargs.get(\"multihead\", False)\n",
    "    alpha          = kwargs.get(\"alpha\", 1.0)\n",
    "    hour_loss_FM   = kwargs.get(\"hour_loss_fn\", nn.CrossEntropyLoss())\n",
    "    minute_loss_FM = kwargs.get(\"minute_loss_fn\", nn.CrossEntropyLoss())\n",
    "    loss_FM        = kwargs.get(\"loss_fn\", nn.MSELoss() if regression else nn.CrossEntropyLoss())\n",
    "    num_classes    = kwargs.get(\"num_classes\", 10)\n",
    "    average        = kwargs.get(\"average\", \"macro\")\n",
    "    dev            = kwargs.get(\"device\", device)\n",
    "\n",
    "    if not (regression or multihead):\n",
    "        acc  = MulticlassAccuracy(num_classes=num_classes).to(dev)\n",
    "        prec = MulticlassPrecision(num_classes=num_classes, average=average).to(dev)\n",
    "        f1   = MulticlassF1Score(num_classes=num_classes, average=average).to(dev)\n",
    "\n",
    "    test_loader = DataLoader(test_dataset, batch_size=batch_size, shuffle=False)\n",
    "\n",
    "    test_model.load_state_dict(torch.load(load_path, map_location=dev))\n",
    "    test_model.to(dev)\n",
    "    test_model.eval()\n",
    "\n",
    "    test_loss_total = 0.0\n",
    "    test_err_total = 0.0\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for x, y in test_loader:\n",
    "            x, y = x.to(dev), y.to(dev)\n",
    "            out = test_model(x)\n",
    "            if multihead:\n",
    "                loss, pred_h, true_h = multihead_loss(out, y, hour_loss_FM, minute_loss_FM, alpha)\n",
    "                test_loss_total += loss.item()\n",
    "                test_err_total += common_sense_error_min(pred_h, true_h).mean().item()\n",
    "            elif regression:\n",
    "                out = out.squeeze(1)\n",
    "                y = y.float()\n",
    "                test_loss_total += loss_FM(out, y).item()\n",
    "                test_err_total += common_sense_error_min(out, y).mean().item()\n",
    "            else:\n",
    "                test_loss_total += loss_FM(out, y).item()\n",
    "                preds = out.argmax(dim=1)\n",
    "                acc.update(preds, y)\n",
    "                prec.update(preds, y)\n",
    "                f1.update(preds, y)\n",
    "\n",
    "    if regression or multihead:\n",
    "        result = {\n",
    "            \"loss\": test_loss_total / len(test_loader),\n",
    "            \"mae_min\": test_err_total / len(test_loader),\n",
    "        }\n",
    "        print(f\"test | loss {result['loss']:.4f} | MAE {result['mae_min']:.1f} min\")\n",
    "    else:\n",
    "        result = {\n",
    "            \"loss\": test_loss_total / len(test_loader),\n",
    "            \"acc\": acc.compute().item(),\n",
    "            \"prec\": prec.compute().item(),\n",
    "            \"f1\": f1.compute().item(),\n",
    "        }\n",
    "        print(f\"test | loss {result['loss']:.4f} | \"\n",
    "              f\"Accuracy {result['acc']:.4f} | Precision {result['prec']:.4f} | F1 {result['f1']:.4f}\")\n",
    "\n",
    "    # save the test result next to the training history: history_saved/<weights name>_test.csv\n",
    "    os.makedirs(\"history_saved\", exist_ok=True)\n",
    "    name = os.path.splitext(os.path.basename(load_path))[0]\n",
    "    with open(f\"history_saved/{name}_test.csv\", \"w\", newline=\"\") as f:\n",
    "        writer = csv.writer(f)\n",
    "        writer.writerow(result.keys())\n",
    "        writer.writerow(result.values())\n",
    "    return result"
