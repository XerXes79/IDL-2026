    "def multihead_loss(out, y, hour_loss_fn, minute_loss_fn, alpha=1.0):\n",
    "    \"\"\"L = L_hour + alpha * L_minute.  y = (hour, minute).\n",
    "    The number of model outputs decides the type of each head:\n",
    "      72 outputs: hour classification (12) + minute classification (60)\n",
    "      13 outputs: hour classification (12) + minute regression (1, target minutes / 60)\n",
    "       2 outputs: hour regression (1, target hour / 12) + minute regression (1, target minutes / 60)\n",
    "    out can also be the pair (out_hour, out_minute).\n",
    "    Returns the loss and the predicted / true time in hours.\"\"\"\n",
    "    if isinstance(out, tuple):                                   # (out_hour, out_minute) from MultiHeadCNN\n",
    "        out = torch.cat(out, dim=1)\n",
    "    hour, minute = y[:, 0], y[:, 1]\n",
    "    if out.shape[1] == 2:                                        # hour regression\n",
    "        h_out, m_out = out[:, :1], out[:, 1:]\n",
    "        loss_h = hour_loss_fn(h_out.squeeze(1), hour.float() / 12)\n",
    "        h_cont = h_out.squeeze(1).detach() * 12                  # raw hour output, e.g. 2.6\n",
    "    else:                                                        # hour classification\n",
    "        h_out, m_out = out[:, :12], out[:, 12:]\n",
    "        loss_h = hour_loss_fn(h_out, hour)\n",
    "        h_cont = None\n",
    "    if m_out.shape[1] == 1:                                      # minute regression\n",
    "        loss_m = minute_loss_fn(m_out.squeeze(1), minute.float() / 60)\n",
    "        m_pred = m_out.squeeze(1).detach() * 60\n",
    "    else:                                                        # minute classification\n",
    "        loss_m = minute_loss_fn(m_out, minute)\n",
    "        m_pred = m_out.argmax(dim=1)\n",
    "    if h_cont is None:\n",
    "        h_pred = h_out.argmax(dim=1)\n",
    "    else:\n",
    "        h_pred = torch.floor(h_cont) % 12                        # or: torch.round(h_cont - m_pred / 60) % 12\n",
    "    pred_hours = h_pred + m_pred / 60\n",
    "    true_hours = hour + minute / 60\n",
    "    return loss_h + alpha * loss_m, pred_hours, true_hours"
   ],
   "outputs": [],
