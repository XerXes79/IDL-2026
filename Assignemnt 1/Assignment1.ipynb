   "source": [
    "class MultiHeadCNN(nn.Module):\n",
    "    \"\"\"Shared backbone (conv layers + the hidden MLP layers) with two separate output heads:\n",
    "        out_hour, out_minute = model(x)\n",
    "    cnn   : a clock CNN whose last Linear layer has n_hour + n_minute outputs.\n",
    "    n_hour: outputs of the hour head (12 for classification, 1 for regression); the rest go to the minute head.\n",
    "    The heads start as the two parts of that last Linear layer, so this model computes exactly the same\n",
    "    as the single-output CNN, and the random number generator is left untouched (a rerun gives the same\n",
    "    initial weights as before).\"\"\"\n",
    "    def __init__(self, cnn, n_hour):\n",
    "        super().__init__()\n",
    "        *body, last = cnn.classifier.linear_stack\n",
    "        self.features = cnn.features\n",
    "        self.shared = nn.Sequential(nn.Flatten(), *body)\n",
    "        with torch.random.fork_rng(devices=[]):           # creating the heads must not change the random state\n",
    "            self.hour_head = nn.Linear(last.in_features, n_hour, device=last.weight.device)\n",
    "            self.minute_head = nn.Linear(last.in_features, last.out_features - n_hour, device=last.weight.device)\n",
    "        with torch.no_grad():\n",
    "            self.hour_head.weight.copy_(last.weight[:n_hour]);   self.hour_head.bias.copy_(last.bias[:n_hour])\n",
    "            self.minute_head.weight.copy_(last.weight[n_hour:]); self.minute_head.bias.copy_(last.bias[n_hour:])\n",
    "\n",
    "    def forward(self, x):\n",
    "        z = self.shared(self.features(x))\n",
    "        return self.hour_head(z), self.minute_head(z)\n",
    "\n",
    "    def load_state_dict(self, state_dict, strict=True, assign=False):\n",
    "        \"\"\"Also loads weights saved from the single-output CNN (one last Linear layer with all outputs).\"\"\"\n",
    "        if any(k.startswith(\"classifier.\") for k in state_dict):\n",
    "            state_dict = dict(state_dict)\n",
    "            last = len(self.shared) - 1                       # index of the last Linear in the old linear_stack\n",
    "            n_hour = self.hour_head.out_features\n",
    "            for k in [k for k in state_dict if k.startswith(\"classifier.linear_stack.\")]:\n",
    "                i, name = int(k.split(\".\")[2]), k.split(\".\")[3]\n",
    "                v = state_dict.pop(k)\n",
    "                if i == last:\n",
    "                    state_dict[f\"hour_head.{name}\"], state_dict[f\"minute_head.{name}\"] = v[:n_hour], v[n_hour:]\n",
    "                else:\n",
    "                    state_dict[f\"shared.{i + 1}.{name}\"] = v       # +1 because shared starts with Flatten\n",
    "        return super().load_state_dict(state_dict, strict=strict, assign=assign)"
   ],
