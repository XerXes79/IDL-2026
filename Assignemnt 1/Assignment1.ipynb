    "model_TellTheTime_reg.load_state_dict(torch.load(f\"weights_saved/{base}.pt\", map_location=device))\n",
    "\n",
    "history_reg_mse_cont, best_reg_mse_cont = train_model(model=model_TellTheTime_reg,\n",
    "                                                      train_dataset=training_data_aug_reg,\n",
    "                                                      regression=True, loss_fn=loss_reg,\n",
    "                                                      save_path=f\"{cont_name}.pt\",\n",
    "                                                      epoches=40, lr=3e-4,\n",
    "                                                      optimizer_cls=torch.optim.AdamW,\n",
    "                                                      optimizer_kwargs={\"weight_decay\": 0.05},\n",
    "                                                      val_ratio=0.1111)\n",
    "\n",
    "# glue: first run (150 epochs) + continued run\n",
    "history_first, _ = load_run(base)\n",
    "history_cont, _  = load_run(cont_name)\n",
    "history_reg_mse_full = {k: history_first[k] + history_cont[k] for k in history_first}\n",
    "\n",
    "with open(f\"history_saved/{full_name}.csv\", \"w\", newline=\"\") as f:\n",
    "    writer = csv.writer(f)\n",
    "    writer.writerow([\"epoch\"] + list(history_reg_mse_full))\n",
    "    for e in range(len(history_reg_mse_full[\"train_loss\"])):\n",
    "        writer.writerow([e] + [history_reg_mse_full[k][e] for k in history_reg_mse_full])\n",
    "\n",
    "plot_history(history_reg_mse_full,\n",
    "             title=f\"Tell the time, regression (MSE), {len(history_reg_mse_full['train_loss'])} epochs\")"
   ]
