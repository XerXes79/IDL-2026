    "    nn.MaxPool2d(2),\n",
    "    nn.Dropout2d(0.1),\n",
    "    nn.Conv2d(75, 128, kernel_size=3, padding=1),   nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.Conv2d(128, 128, kernel_size=3, padding=1),  nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.MaxPool2d(2),\n",
    "    nn.Dropout2d(0.2),\n",
    "    nn.Conv2d(128, 184, kernel_size=3, padding=1),  nn.BatchNorm2d(184), nn.ReLU(),\n",
