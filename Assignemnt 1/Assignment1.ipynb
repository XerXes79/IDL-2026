    "def common_sense_error_min(pred_hours, true_hours):\n",
    "    \"\"\"Absolute time difference in minutes on a 12-hour clock: 11:55 vs 0:05 -> 10 min.\"\"\"\n",
    "    d = torch.remainder(pred_hours - true_hours, 12)\n",
    "    return torch.minimum(d, 12 - d) * 60\n",
    "\n",
    "\n",
    "def train_model(**kwargs):\n",
    "    \"\"\"Function to do the training by getting model and training set as input also gets other parameters.\n",
    "    default         : classification (CrossEntropyLoss, accuracy / precision / F1).\n",
    "    regression=True : one continuous output per image (e.g. 10.5 for 10:30), a loss such as\n",
    "                      nn.MSELoss / nn.L1Loss / nn.SmoothL1Loss.\n",
    "    multihead=True  : hour head (12 outputs) + minute head (60 outputs, or 1 for minute regression),\n",
    "                      L = L_hour + alpha * L_minute with hour_loss_fn / minute_loss_fn.\n",
    "    \"\"\"\n",
    "    #unpacking the arguments\n",
    "    model          = kwargs.get(\"model\", NeuralNetwork())\n",
    "    train_dataset  = kwargs.get(\"train_dataset\", training_data)\n",
    "    seed           = kwargs.get(\"seed\", 528)\n",
    "    epoches        = kwargs.get(\"epoches\", 15)\n",
    "    lr             = kwargs.get(\"lr\", 0.003)\n",
    "    optimizer_cls  = kwargs.get(\"optimizer_cls\", torch.optim.Adam)\n",
    "    regression     = kwargs.get(\"regression\", False)\n",
    "    multihead      = kwargs.get(\"multihead\", False)\n",
    "    alpha          = kwargs.get(\"alpha\", 1.0)                          # L = L_hour + alpha * L_minute\n",
    "    hour_loss_FM   = kwargs.get(\"hour_loss_fn\", nn.CrossEntropyLoss())\n",
    "    minute_loss_FM = kwargs.get(\"minute_loss_fn\", nn.CrossEntropyLoss())\n",
    "    loss_FM        = kwargs.get(\"loss_fn\", nn.MSELoss() if regression else nn.CrossEntropyLoss())\n",
    "    val_ratio      = kwargs.get(\"val_ratio\", 0.2)\n",
    "    batch_size     = kwargs.get(\"batch_size\", 64)\n",
    "    num_classes    = kwargs.get(\"num_classes\", 10)\n",
    "    average        = kwargs.get(\"average\", \"macro\")\n",
    "    save_path      = kwargs.get(\"save_path\", \"best_model.pt\")\n",
    "    dev            = kwargs.get(\"device\", device)\n",
    "    weight_init    = kwargs.get(\"weight_init\", None)\n",
    "    bias_init      = kwargs.get(\"bias_init\", None)\n",
    "    optimizer_kwargs = kwargs.get(\"optimizer_kwargs\", {})\n",
    "    os.makedirs(\"weights_saved\", exist_ok=True)\n",
    "    os.makedirs(\"history_saved\", exist_ok=True)\n",
    "    # same name as the weights file, but .csv in the history_saved folder\n",
    "    csv_path = \"history_saved/\" + os.path.splitext(save_path)[0] + \".csv\"\n",
    "    save_path = \"weights_saved/\"+ save_path\n",
    "    # To record how the training goes and then use this dictionary to draw plots\n",
    "    if regression or multihead:\n",
    "        history = {\"train_loss\": [], \"train_mae_min\": [], \"val_loss\": [], \"val_mae_min\": []}\n",
    "        best_val = float(\"inf\")            # lower error is better\n",
    "    else:\n",
    "        history = {\n",
    "            \"train_loss\": [], \"train_acc\": [], \"train_prec\": [], \"train_f1\": [],\n",
    "            \"val_loss\": [],   \"val_acc\": [],   \"val_prec\": [],   \"val_f1\": [],\n",
    "        }\n",
    "        best_val = 0.0                     # classification: higher accuracy is better\n",
    "        # Metrics used for observation and evaluation of training\n",
    "        acc  = MulticlassAccuracy(num_classes=num_classes).to(dev)\n",
    "        prec = MulticlassPrecision(num_classes=num_classes, average=average).to(dev)\n",
    "        f1   = MulticlassF1Score(num_classes=num_classes, average=average).to(dev)\n",
    "    # weight initialization\n",
    "    init_weights(model, weight_init, bias_init)\n",
    "    #defining the optimizer and passing the values\n",
    "    optimizer = optimizer_cls(model.parameters(), lr=lr, **optimizer_kwargs)\n",
    "    #making the training and validation split with percentage of the whole training dataset\n",
    "    train_split, val_split = random_split(train_dataset, [len(train_dataset) - int(len(train_dataset) * val_ratio), int(len(train_dataset) * val_ratio)], generator=torch.Generator().manual_seed(seed))\n",
    "    train_loader = DataLoader(dataset=train_split, batch_size=batch_size, shuffle=True)\n",
    "    val_loader = DataLoader(dataset=val_split, batch_size=batch_size, shuffle=True)\n",
    "\n",
    "    train_bar = tqdm(total=len(train_loader), desc=\"train\")\n",
    "    val_bar   = tqdm(total=len(val_loader),   desc=\"val\")\n",
    "    # Training loop\n",
    "    for epoch in trange(epoches, desc=\"Training\"):\n",
    "\n",
    "        train_loss_total = 0.0\n",
    "        val_loss_total = 0.0\n",
    "        train_err_total = 0.0\n",
    "        val_err_total = 0.0\n",
    "        model.train().to(dev)\n",
    "\n",
    "        train_bar.reset()\n",
    "        train_bar.set_description(f\"epoch {epoch} train\")\n",
    "        for x, y in train_loader:\n",
    "            x = x.to(dev)\n",
    "            y = y.to(dev)\n",
    "            out = model(x)\n",
    "            if regression:\n",
    "                out = out.squeeze(1)       # (N, 1) -> (N,), same shape as the targets\n",
    "                y = y.float()\n",
    "            if multihead:\n",
    "                loss, pred_h, true_h = multihead_loss(out, y, hour_loss_FM, minute_loss_FM, alpha)\n",
    "            else:\n",
    "                loss = loss_FM(out, y)\n",
    "                pred_h, true_h = out, y              # regression: the output is the time in hours\n",
    "            optimizer.zero_grad()\n",
    "            loss.backward()\n",
    "            optimizer.step()\n",
    "\n",
    "            train_loss_total += loss.item()\n",
    "            if regression or multihead:\n",
    "                err_v = common_sense_error_min(pred_h.detach(), true_h).mean().item()   # minutes, with 12-hour wrap-around\n",
    "                train_err_total += err_v\n",
    "                train_bar.set_postfix(loss=f\"{loss.item():.4f}\", mae_min=f\"{err_v:.1f}\")\n",
    "            else:\n",
    "                preds = out.argmax(dim=1)\n",
    "                acc_v = acc(preds, y)\n",
    "                prec_v = prec(preds, y)\n",
    "                f1_v = f1(preds, y)\n",
    "                train_bar.set_postfix(loss=f\"{loss.item():.4f}\", acc=f\"{acc_v:.4f}\",\n",
    "                                      prec=f\"{prec_v:.4f}\", f1=f\"{f1_v:.4f}\")\n",
    "            train_bar.update(1)\n",
    "\n",
    "        history[\"train_loss\"].append(train_loss_total / len(train_loader))\n",
    "        if regression or multihead:\n",
    "            history[\"train_mae_min\"].append(train_err_total / len(train_loader))\n",
    "            tqdm.write(f\"epoch {epoch} train | loss {history['train_loss'][-1]:.4f} | \"\n",
    "                       f\"MAE {history['train_mae_min'][-1]:.1f} min\")\n",
    "        else:\n",
    "            history[\"train_acc\"].append(acc.compute().item())\n",
    "            history[\"train_prec\"].append(prec.compute().item())\n",
    "            history[\"train_f1\"].append(f1.compute().item())\n",
    "            tqdm.write(f\"epoch {epoch} train | loss {history['train_loss'][-1]:.4f} | \"\n",
    "                       f\"Accuracy {history['train_acc'][-1]:.4f} | Precision {history['train_prec'][-1]:.4f} | \"\n",
    "                       f\"F1 {history['train_f1'][-1]:.4f}\")\n",
    "            acc.reset()\n",
    "            prec.reset()\n",
    "            f1.reset()\n",
    "        # each epoch we evaluate using validation set and save the best model on validation set\n",
    "        with torch.no_grad():\n",
    "            model.eval()\n",
    "            val_bar.reset()\n",
    "            val_bar.set_description(f\"epoch {epoch} val\")\n",
    "            for x, y in val_loader:\n",
    "                x = x.to(dev)\n",
    "                y = y.to(dev)\n",
    "                out = model(x)\n",
    "                if regression:\n",
    "                    out = out.squeeze(1)\n",
    "                    y = y.float()\n",
    "                if multihead:\n",
    "                    loss, pred_h, true_h = multihead_loss(out, y, hour_loss_FM, minute_loss_FM, alpha)\n",
    "                else:\n",
    "                    loss = loss_FM(out, y)\n",
    "                    pred_h, true_h = out, y\n",
    "                val_loss_total += loss.item()\n",
    "                if regression or multihead:\n",
    "                    err_v = common_sense_error_min(pred_h, true_h).mean().item()\n",
    "                    val_err_total += err_v\n",
    "                    val_bar.set_postfix(loss=f\"{loss.item():.4f}\", mae_min=f\"{err_v:.1f}\")\n",
    "                else:\n",
    "                    preds = out.argmax(dim=1)\n",
    "                    acc_v = acc(preds, y)\n",
    "                    prec_v = prec(preds, y)\n",
    "                    f1_v = f1(preds, y)\n",
    "                    val_bar.set_postfix(loss=f\"{loss.item():.4f}\", acc=f\"{acc_v:.4f}\")\n",
    "                val_bar.update(1)\n",
    "\n",
    "        history[\"val_loss\"].append(val_loss_total / len(val_loader))\n",
    "        if regression or multihead:\n",
    "            history[\"val_mae_min\"].append(val_err_total / len(val_loader))\n",
    "            tqdm.write(f\"epoch {epoch} val   | loss {history['val_loss'][-1]:.4f} | \"\n",
    "                       f\"MAE {history['val_mae_min'][-1]:.1f} min\")\n",
    "            current = history[\"val_mae_min\"][-1]\n",
    "            improved = current < best_val\n",
    "        else:\n",
    "            history[\"val_acc\"].append(acc.compute().item())\n",
    "            history[\"val_prec\"].append(prec.compute().item())\n",
    "            history[\"val_f1\"].append(f1.compute().item())\n",
    "            tqdm.write(f\"epoch {epoch} val   | loss {history['val_loss'][-1]:.4f} | \"\n",
    "                       f\"Accuracy {history['val_acc'][-1]:.4f} | Precision {history['val_prec'][-1]:.4f} | \"\n",
    "                       f\"F1 {history['val_f1'][-1]:.4f}\")\n",
    "            current = history[\"val_acc\"][-1]\n",
    "            improved = current > best_val\n",
    "            acc.reset()\n",
    "            prec.reset()\n",
    "            f1.reset()\n",
    "\n",
    "        if improved:\n",
    "            best_val = current\n",
    "            torch.save(model.state_dict(), save_path)\n",
    "            tqdm.write(f\"new best val {'MAE' if regression or multihead else 'acc'} {best_val:.4f}, saved\")\n",
    "\n",
    "        # write the history so far to csv after every epoch (one row per epoch)\n",
    "        with open(csv_path, \"w\", newline=\"\") as f:\n",
    "            writer = csv.writer(f)\n",
    "            writer.writerow([\"epoch\"] + list(history.keys()))\n",
    "            for e in range(len(history[\"train_loss\"])):\n",
    "                writer.writerow([e] + [history[k][e] for k in history])\n",
    "\n",
    "    train_bar.close()\n",
    "    val_bar.close()\n",
    "\n",
    "    return history, best_val"
