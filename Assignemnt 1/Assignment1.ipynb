    "model_fashion_cnn_deep = CNN(image_size=28, in_channel=1, x=0.3, y=0.3, conv_layers=nn.Sequential(\n",
    "    nn.Conv2d(1,  32, kernel_size=3, padding=1),  nn.BatchNorm2d(32),  nn.ReLU(),\n",
    "    nn.Conv2d(32, 32, kernel_size=3, padding=1),  nn.BatchNorm2d(32),  nn.ReLU(),\n",
    "    nn.MaxPool2d(2),                                                   # 28 -> 14\n",
    "    nn.Dropout2d(0.1),\n",
    "    nn.Conv2d(32, 64, kernel_size=3, padding=1),  nn.BatchNorm2d(64),  nn.ReLU(),\n",
    "    nn.Conv2d(64, 64, kernel_size=3, padding=1),  nn.BatchNorm2d(64),  nn.ReLU(),\n",
    "    nn.MaxPool2d(2),                                                   # 14 -> 7\n",
    "    nn.Dropout2d(0.2),\n",
    "    nn.Conv2d(64, 128, kernel_size=3, padding=1), nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.Conv2d(128,128, kernel_size=3, padding=1), nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.AdaptiveAvgPool2d(1),                                           # 128 features\n",
    "))\n",
    "\n",
    "# augmented training data: small shifts and left/right flips\n",
    "aug = v2.Compose([v2.ToImage(), v2.RandomCrop(28, padding=2), v2.RandomHorizontalFlip(),\n",
    "                  v2.ToDtype(torch.float32, scale=True)])\n",
    "training_data_aug = datasets.FashionMNIST(root=\"data\", train=True, download=True, transform=aug)\n",
    "\n",
    "history_fashion_cnn_deep, best_fashion_cnn_deep = train_model(model=model_fashion_cnn_deep,\n",
    "                                                              train_dataset=training_data_aug,\n",
    "                                                              save_path=\"best_model_CNN_FAshion_deep.pt\",\n",
    "                                                              epoches=30, lr=1e-3,\n",
    "                                                              optimizer_cls=torch.optim.AdamW,\n",
    "                                                              optimizer_kwargs={\"weight_decay\": 0.05})\n",
    "test_fashion_cnn_deep = evaluate_model(model=model_fashion_cnn_deep,\n",
    "                                       load_path=\"weights_saved/best_model_CNN_FAshion_deep.pt\")\n",
    "plot_history(history_fashion_cnn_deep, test_fashion_cnn_deep, title=\"FashionMNIST CNN, 6 conv + BN + aug\")"
   ]
  },
