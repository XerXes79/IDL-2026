    "\n",
    "training_data_aug_TellTheTime = Augmented(clock_train, aug_clock)\n",
    "\n",
    "model_TellTheTime_Classification = CNN(image_size=75, in_channel=1, x=0.3, y=0.3, num_classes=n_classes,\n",
    "                                       conv_layers=nn.Sequential(\n",
    "    nn.Conv2d(1,  75, kernel_size=3, padding=1),    nn.BatchNorm2d(75),  nn.ReLU(),\n",
    "    nn.Conv2d(75, 75, kernel_size=3, padding=1),    nn.BatchNorm2d(75),  nn.ReLU(),\n",
    "    nn.MaxPool2d(2),\n",
    "    nn.Dropout2d(0.1),\n",
    "    nn.Conv2d(75, 128, kernel_size=3, padding=1),   nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.Conv2d(128, 128, kernel_size=3, padding=1),  nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.MaxPool2d(2),\n",
    "    nn.Dropout2d(0.2),\n",
    "    nn.Conv2d(128, 184, kernel_size=3, padding=1),  nn.BatchNorm2d(184), nn.ReLU(),\n",
    "    nn.Conv2d(184, 184, kernel_size=3, padding=1),  nn.BatchNorm2d(184), nn.ReLU(),\n",
    "    nn.AdaptiveAvgPool2d(1),\n",
    "))\n",
    "\n",
    "history_TellTheTime_cnn_deep, best_TellTheTime_cnn_deep = train_model(model=model_TellTheTime_Classification,\n",
    "                                                              train_dataset=training_data_aug_TellTheTime,\n",
    "                                                              num_classes=n_classes,\n",
    "                                                              save_path=f\"best_model_CNN_TellTheTime_deep_{n_classes}.pt\",\n",
    "                                                              epoches=70, lr=1e-3,\n",
    "                                                              optimizer_cls=torch.optim.AdamW,\n",
    "                                                              optimizer_kwargs={\"weight_decay\": 0.05},\n",
    "                                                                      val_ratio=0.1111)\n",
    "test_TellTheTime_cnn_deep = evaluate_model(model=model_TellTheTime_Classification, test_dataset=clock_test,\n",
    "                                           num_classes=n_classes,\n",
    "                                           load_path=f\"weights_saved/best_model_CNN_TellTheTime_deep_{n_classes}.pt\")\n",
    "plot_history(history_TellTheTime_cnn_deep, test_TellTheTime_cnn_deep,\n",
    "             title=f\"Tell the time, classification ({n_classes} classes)\")"
   ]
