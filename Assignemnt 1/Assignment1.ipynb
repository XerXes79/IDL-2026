    "    writer = csv.writer(f)\n",
    "    writer.writerow(test_TellTheTime_1min_cont.keys())\n",
    "    writer.writerow(test_TellTheTime_1min_cont.values())\n",
    "\n",
    "plot_history(history_TellTheTime_1min_full, test_TellTheTime_1min_cont,\n",
    "             title=f\"Tell the time, classification ({n_classes} classes), \"\n",
    "                   f\"{len(history_TellTheTime_1min_full['train_loss'])} epochs\")"
