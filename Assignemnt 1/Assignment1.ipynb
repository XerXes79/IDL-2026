    "images = torch.from_numpy(TellTheTime['images.npy']).float().unsqueeze(1) / 255     # (N, 1, H, W), values 0..1\n",
    "labels = torch.from_numpy(TellTheTime['labels.npy'])\n",
    "\n",
    "bin_minutes = 30\n",
    "n_classes = 720 // bin_minutes\n",
    "minutes = (labels[:, 0] % 12) * 60 + labels[:, 1]                          # (hour, minute) -> 0..719\n",
    "targets = (minutes // bin_minutes).long()                                  # class index\n",
    "\n",
    "clock = TensorDataset(images, targets)\n",
    "clock_train, clock_test = random_split(clock, [0.9, 0.1],\n",
    "                                       generator=torch.Generator().manual_seed(528))"
