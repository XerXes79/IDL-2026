    "    out = torch.cat([torch.cat(model(x.to(device)), dim=1).cpu() for x, _ in DataLoader(val_mh, batch_size=64)])\n",
    "    y = torch.cat([y for _, y in DataLoader(val_mh, batch_size=64)])\n",
    "h_pred = out[:, :12].argmax(1) if out.shape[1] > 2 else torch.round(out[:, 0] * 12) % 12\n",
    "m_pred = out[:, 12:].argmax(1) if out.shape[1] == 72 else out[:, -1] * 60\n",
    "m_err = torch.minimum((m_pred - y[:, 1]).abs() % 60, 60 - (m_pred - y[:, 1]).abs() % 60)\n",
    "print(f\"hour accuracy {(h_pred == y[:, 0]).float().mean():.3f} | minute error {m_err.mean():.1f} min\")"
