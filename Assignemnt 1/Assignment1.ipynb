   "source": [
    "training_data_aug_TellTheTime_1min = Augmented(clock_train_1min, aug_clock)\n",
    "\n",
    "model_TellTheTime_Classification_1min = CNN(image_size=75, in_channel=1, x=0.3, y=0.3, num_classes=n_classes,\n",
    "                                       conv_layers=nn.Sequential(\n",
    "    nn.Conv2d(1,  75, kernel_size=3, padding=1),    nn.BatchNorm2d(75),  nn.ReLU(),\n",
    "    nn.Conv2d(75, 75, kernel_size=3, padding=1),    nn.BatchNorm2d(75),  nn.ReLU(),\n",
    "    nn.MaxPool2d(2),\n",
    "    nn.Dropout2d(0.1),\n",
    "    nn.Conv2d(75, 128, kernel_size=3, padding=1),   nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.Conv2d(128, 128, kernel_size=3, padding=1),  nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.MaxPool2d(2),\n",
    "    nn.Dropout2d(0.2),\n",
    "    nn.Conv2d(128, 184, kernel_size=3, padding=1),  nn.BatchNorm2d(184), nn.ReLU(),\n",
    "    nn.Conv2d(184, 184, kernel_size=3, padding=1),  nn.BatchNorm2d(184), nn.ReLU(),\n",
    "    nn.AdaptiveAvgPool2d(1),\n",
    "))\n",
    "\n",
    "base      = f\"best_model_CNN_TellTheTime_deep_{n_classes}\"\n",
    "prev_name = f\"{base}_cont\"\n",
    "cont_name = f\"{base}_cont2\"\n",
    "full_name = f\"{base}_full\"\n",
    "\n",
    "model_TellTheTime_Classification_1min.load_state_dict(\n",
    "    torch.load(f\"weights_saved/{prev_name}.pt\", map_location=device))\n",
    "\n",
    "history_TellTheTime_1min_cont2, best_TellTheTime_1min_cont2 = train_model(model=model_TellTheTime_Classification_1min,\n",
    "                                                              train_dataset=training_data_aug_TellTheTime_1min,\n",
    "                                                              num_classes=n_classes,\n",
    "                                                              save_path=f\"{cont_name}.pt\",\n",
    "                                                              epoches=40, lr=1e-4,\n",
    "                                                              optimizer_cls=torch.optim.AdamW,\n",
    "                                                              optimizer_kwargs={\"weight_decay\": 0.05},\n",
    "                                                              val_ratio=0.1111)\n",
    "test_TellTheTime_1min_cont2 = evaluate_model(model=model_TellTheTime_Classification_1min, test_dataset=clock_test_1min,\n",
    "                                             num_classes=n_classes,\n",
    "                                             load_path=f\"weights_saved/{cont_name}.pt\")\n",
    "\n",
    "# glue all three parts: 250 + 30 + 40 epochs\n",
    "history_a, _ = load_run(base)\n",
    "history_b, _ = load_run(prev_name)\n",
    "history_c, _ = load_run(cont_name)\n",
    "history_TellTheTime_1min_full = {k: history_a[k] + history_b[k] + history_c[k] for k in history_a}\n",
    "\n",
    "with open(f\"history_saved/{full_name}.csv\", \"w\", newline=\"\") as f:\n",
    "    writer = csv.writer(f)\n",
    "    writer.writerow([\"epoch\"] + list(history_TellTheTime_1min_full))\n",
    "    for e in range(len(history_TellTheTime_1min_full[\"train_loss\"])):\n",
    "        writer.writerow([e] + [history_TellTheTime_1min_full[k][e] for k in history_TellTheTime_1min_full])\n",
    "with open(f\"history_saved/{full_name}_test.csv\", \"w\", newline=\"\") as f:\n",
    "    writer = csv.writer(f)\n",
    "    writer.writerow(test_TellTheTime_1min_cont2.keys())\n",
    "    writer.writerow(test_TellTheTime_1min_cont2.values())\n",
    "\n",
    "plot_history(history_TellTheTime_1min_full, test_TellTheTime_1min_cont2,\n",
    "             title=f\"Tell the time, classification ({n_classes} classes), \"\n",
    "                   f\"{len(history_TellTheTime_1min_full['train_loss'])} epochs\")"
   ]
  },
