    "## CNN (CIFAR-10), passing your own conv `nn.Sequential`\n",
    "model_depth_cnn_seq = CNN(image_size=32, in_channel=3, x=0.2, y=0.2, conv_layers=nn.Sequential(\n",
    "        # Upsample 4x\n",
    "\n",
    "    nn.Conv2d(3,   32, 3, padding=1),           nn.BatchNorm2d(32),  nn.ReLU(),\n",
    "    nn.Conv2d(32,  32, 3, padding=1),           nn.BatchNorm2d(32),  nn.ReLU(),   # 32x32\n",
    "    nn.Conv2d(32,  64, 3, padding=1, stride=2), nn.BatchNorm2d(64),  nn.ReLU(),\n",
    "    nn.Conv2d(64,  64, 3, padding=1),           nn.BatchNorm2d(64),  nn.ReLU(),   # 16x16\n",
    "    nn.Conv2d(64, 128, 3, padding=1, stride=2), nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.Conv2d(128,128, 3, padding=1),           nn.BatchNorm2d(128), nn.ReLU(),   # 8x8\n",
    "    nn.Conv2d(128,256, 3, padding=1, stride=2), nn.BatchNorm2d(256), nn.ReLU(),\n",
    "    nn.Conv2d(256,256, 3, padding=1),           nn.BatchNorm2d(256), nn.ReLU(),   # 4x4\n",
    "    nn.AdaptiveAvgPool2d(1),                                                      # 256 features\n",
    ")\n",
    ")\n",
    "\n",
    "history_depth_cnn_seq, best_depth_cnn_seq = train_model(model=model_depth_cnn_seq,\n",
    "                                                        save_path=\"best_model_depth_cnn_seq_f.pt\", epoches=40,\n",
    "                                                         lr=3e-4,\n",
    "                                                        train_dataset= Trainig_data_ci,\n",
    "                                                        optimizer_cls=torch.optim.AdamW,\n",
    "                                                        optimizer_kwargs={\"weight_decay\": 0.05})\n",
    "evaluate_model(model=model_depth_cnn_seq, load_path=\"weights_saved/best_model_depth_cnn_seq_f.pt\",\n",
    "               test_dataset=test_data_ci)\n"
   ]
  },
