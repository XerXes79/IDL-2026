    "# same network as the 75x75 run, so the saved weights fit exactly\n",
    "model_TellTheTime_Classification_1min_150 = CNN(image_size=150, in_channel=1, x=0.3, y=0.3, num_classes=n_classes,\n",
    "                                       conv_layers=nn.Sequential(\n",
    "    nn.Conv2d(1,  75, kernel_size=3, padding=1),    nn.BatchNorm2d(75),  nn.ReLU(),\n",
    "    nn.Conv2d(75, 75, kernel_size=3, padding=1),    nn.BatchNorm2d(75),  nn.ReLU(),\n",
    "    nn.MaxPool2d(2),\n",
    "    nn.Dropout2d(0.1),\n",
    "    nn.Conv2d(75, 128, kernel_size=3, padding=1),   nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.Conv2d(128, 128, kernel_size=3, padding=1),  nn.BatchNorm2d(128), nn.ReLU(),\n",
    "    nn.MaxPool2d(2),\n",
    "    nn.Dropout2d(0.2),\n",
    "    nn.Conv2d(128, 184, kernel_size=3, padding=1),  nn.BatchNorm2d(184), nn.ReLU(),\n",
    "    nn.Conv2d(184, 184, kernel_size=3, padding=1),  nn.BatchNorm2d(184), nn.ReLU(),\n",
    "    nn.AdaptiveAvgPool2d(1),\n",
    "))\n",
    "\n",
    "# 1. load the best 75x75 weights for the same number of classes\n",
    "model_TellTheTime_Classification_1min_150.load_state_dict(\n",
    "    torch.load(f\"weights_saved/best_model_CNN_TellTheTime_deep_{n_classes}_cont.pt\", map_location=device))\n",
    "\n",
    "# 2. put a learnable stride-2 layer in front (150 -> 75), starting as a 2x2 average\n",
    "stem = nn.Conv2d(1, 1, kernel_size=2, stride=2, bias=False)\n",
    "nn.init.constant_(stem.weight, 0.25)\n",
    "model_TellTheTime_Classification_1min_150.features.conv_stack = nn.Sequential(\n",
    "    stem, *model_TellTheTime_Classification_1min_150.features.conv_stack)\n",
    "\n",
    "# 3. fine-tune on 150x150\n",
    "history_TellTheTime_1min_cnn_deep_150, best_TellTheTime_1min_cnn_deep_150 = train_model(model=model_TellTheTime_Classification_1min_150,\n",
