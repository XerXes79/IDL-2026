    "def plot_history(history, test=None, title=\"\", log_loss=False):\n",
    "    \"\"\"Plot train and validation curves per epoch (from train_model). Shows accuracy / precision / F1\n",
    "    for classification runs and the mean absolute error in minutes for regression runs.\n",
    "    The test result (from evaluate_model) is drawn as a dashed line.\n",
    "    log_loss=True puts the loss panel on a log scale (useful when the loss starts huge).\"\"\"\n",
    "    names = {\"loss\": \"Loss\", \"acc\": \"Accuracy\", \"prec\": \"Precision\", \"f1\": \"F1\",\n",
    "             \"mae_min\": \"Mean absolute error (minutes)\"}\n",
    "    metrics = [(key, name) for key, name in names.items() if f\"train_{key}\" in history]\n",
    "    epochs = range(1, len(history[\"train_loss\"]) + 1)\n",
    "\n",
    "    rows = (len(metrics) + 1) // 2\n",
    "    fig, axes = plt.subplots(rows, 2, figsize=(12, 4 * rows), squeeze=False)\n",
    "    for ax, (key, name) in zip(axes.flat, metrics):\n",
    "        ax.plot(epochs, history[f\"train_{key}\"], marker=\"o\", label=\"train\")\n",
    "        ax.plot(epochs, history[f\"val_{key}\"], marker=\"o\", label=\"validation\")\n",
    "        if test is not None:\n",
    "            ax.axhline(test[key], color=\"red\", linestyle=\"--\", label=f\"test ({test[key]:.3f})\")\n",
    "        ax.set_title(name)\n",
    "        if key == \"loss\" and log_loss:\n",
    "            ax.set_yscale(\"log\")\n",
    "        ax.set_xlabel(\"epoch\")\n",
    "        ax.grid(alpha=0.3)\n",
    "        ax.legend()\n",
    "    fig.suptitle(title)\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def load_run(name, folder=\"history_saved\"):\n",
    "    \"\"\"Read a run back from its csv files. `name` is the weights file name,\n",
    "    with or without folder and .pt (e.g. \"best_model_CNN_CIFAR\" or \"weights_saved/best_model_CNN_CIFAR.pt\").\n",
    "    Returns (history, test); test is None if that run was never evaluated.\"\"\"\n",
    "    name = os.path.basename(name)\n",
    "    if name.endswith(\".pt\"):\n",
    "        name = name[:-3]\n",
    "    with open(f\"{folder}/{name}.csv\", newline=\"\") as f:\n",
    "        rows = list(csv.DictReader(f))\n",
    "    history = {k: [float(r[k]) for r in rows] for k in rows[0] if k != \"epoch\"}\n",
    "\n",
    "    test = None\n",
    "    if os.path.exists(f\"{folder}/{name}_test.csv\"):\n",
    "        with open(f\"{folder}/{name}_test.csv\", newline=\"\") as f:\n",
    "            test = {k: float(v) for k, v in next(csv.DictReader(f)).items()}\n",
    "    return history, test\n"
