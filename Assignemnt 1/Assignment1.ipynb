    "\n",
    "def clock_cnn_150(n_outputs, weights_75=None):\n",
    "    \"\"\"clock_cnn with a learnable stride-2 layer in front (150x150 -> 75x75).\n",
    "    weights_75: trained 75x75 weights to start from (same number of outputs). The stem starts as a\n",
    "    2x2 average, so the model starts exactly as good as the 75x75 model.\n",
    "    Without weights_75 it only builds the structure, e.g. to load saved 150x150 stride weights.\"\"\"\n",
    "    model = clock_cnn(n_outputs, image_size=150)\n",
    "    if weights_75 is not None:\n",
    "        model.load_state_dict(torch.load(weights_75, map_location=device))\n",
    "    return add_stem(model)\n",
    "\n",
    "\n",
    "def add_stem(model):\n",
    "    \"\"\"Put a learnable stride-2 conv (150x150 -> 75x75) in front of the conv layers, starting as a 2x2 average.\"\"\"\n",
    "    stem = nn.Conv2d(1, 1, kernel_size=2, stride=2, bias=False)\n",
    "    nn.init.constant_(stem.weight, 0.25)\n",
    "    model.features.conv_stack = nn.Sequential(stem, *model.features.conv_stack)\n",
    "    return model\n",
    "\n",
    "\n",
    "def clock_multihead_150(n_outputs, n_hour, weights_75=None):\n",
    "    \"\"\"MultiHeadCNN version of clock_cnn_150 (n_hour: 12 for hour classification, 1 for hour regression).\"\"\"\n",
    "    model = MultiHeadCNN(clock_cnn(n_outputs, image_size=150), n_hour=n_hour)\n",
    "    if weights_75 is not None:\n",
    "        model.load_state_dict(torch.load(weights_75, map_location=device))\n",
    "    return add_stem(model)\n",
    "\n",
